# Copy to deploy/.env.production and fill in. Never commit the filled file.
# Generate secrets with:  openssl rand -hex 32

# Public domain name; Caddy obtains the HTTPS certificate automatically.
SITE_ADDRESS=passport.example.gov.in

POSTGRES_PASSWORD=
JWT_SECRET=

# true ONLY on a demo server with fictional data: enables one-click role login
# and shows the OTP on screen. Must be false once real data is loaded.
DEMO_MODE=false
